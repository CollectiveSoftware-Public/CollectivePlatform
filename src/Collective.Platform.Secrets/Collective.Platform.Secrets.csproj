<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- A shared OS-backed secret store. Kept out of the BCL-only core packages because the Windows
         implementation pulls System.Security.Cryptography.ProtectedData. -->
    <IsPackable>true</IsPackable>
    <PackageId>Collective.Platform.Secrets</PackageId>
    <Description>Shared ISecretStore (persist a master password / token encrypted at rest under the OS user) for the Collective Software heads, with a Windows DPAPI implementation. macOS Keychain / Linux libsecret are future per-OS additions behind the same seam.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows DPAPI (CurrentUser scope). Microsoft-published; restores from nuget.org. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Collective.Platform.Abstractions\Collective.Platform.Abstractions.csproj" />
  </ItemGroup>

</Project>
